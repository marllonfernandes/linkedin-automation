# GCP
GCP_PROJECT_ID=seu-projeto-gcp
GCP_REGION=us-central1
FIRESTORE_DATABASE=(default)
GCS_BUCKET=seu-projeto-gcp-linkedin-assets

# Feeds RSS separados por vírgula (IA, Arquitetura de Soluções, Cloud)
RSS_FEEDS=https://blog.google/technology/ai/rss/,https://aws.amazon.com/blogs/architecture/feed/,https://cloudblog.withgoogle.com/rss/
MAX_DRAFTS_PER_RUN=2

# Gemini API (armazenar no Secret Manager em produção)
GEMINI_API_KEY=sua-chave-gemini
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# Telegram Bot (armazenar no Secret Manager em produção)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_CHAT_ID=123456789
TELEGRAM_WEBHOOK_SECRET=segredo-aleatorio-webhook

# LinkedIn Posts API (OAuth 2.0 - produto Share on LinkedIn)
LINKEDIN_ACCESS_TOKEN=seu-token-oauth-linkedin
LINKEDIN_AUTHOR_URN=urn:li:person:SEU_PERSON_ID
LINKEDIN_API_VERSION=202610
# Opcional: habilita renovação do token em 1 clique pelo Telegram (armazenar secret no Secret Manager)
LINKEDIN_CLIENT_ID=seu-client-id-linkedin
LINKEDIN_CLIENT_SECRET=seu-primary-client-secret-linkedin
LINKEDIN_TOKEN_WARN_DAYS=7

# URL pública do Cloud Run Service (usada para links de aprovação opcionais)
APPROVAL_SERVICE_URL=https://linkedin-approval-service-xxxxx-uc.a.run.app

# Variáveis injetadas dinamicamente pelo Cloud Workflows ao rodar o Cloud Run Job
RUN_ID=local-run-001
CALLBACK_URL=
DRY_RUN=false
